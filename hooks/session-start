#!/usr/bin/env python3
"""SessionStart and post-compaction PreInvocation context delivery for Antigravity."""
import json
import os
from pathlib import Path
import select
import sys
import time

sys.dont_write_bytecode = True
PLUGIN_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PLUGIN_ROOT / 'scripts'))
try:
    from hard_edges import subagent_role
except ImportError:
    subagent_role = lambda event: None


def needs_context(event):
    transcript_path = event.get('transcriptPath')
    if not isinstance(transcript_path, str) or not transcript_path:
        return False

    checkpoint = context = -1
    try:
        with open(transcript_path, encoding='utf-8') as transcript:
            for position, line in enumerate(transcript):
                try:
                    step = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(step, dict):
                    continue
                if step.get('type') == 'CHECKPOINT':
                    checkpoint = position
                elif step.get('type') == 'SYSTEM_MESSAGE':
                    content = step.get('content')
                    if isinstance(content, str) and (
                        'DevStandard operating context: reference/orchestrator.md' in content
                        or 'Stop before acting: DevStandard cannot read ' in content
                    ):
                        context = position
    except (OSError, UnicodeDecodeError, ValueError):
        return False

    return checkpoint >= 0 and context < checkpoint


def main():
    if os.environ.get('DEVSTANDARD_ROLE') in ('worker', 'reviewer'):
        print('{}')
        return

    event = {}
    if not sys.stdin.isatty():
        try:
            # A host may keep the pipe open after its event. Read available bytes,
            # never wait for EOF beyond the startup budget, even with partial data.
            deadline = time.monotonic() + 2
            chunks = []
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not select.select([sys.stdin], [], [], remaining)[0]:
                    break
                chunk = os.read(sys.stdin.fileno(), 65536)
                if not chunk:
                    break
                chunks.append(chunk)
            raw = b''.join(chunks)
            if raw.strip():
                event = json.loads(raw)
        except Exception:
            event = {}

    if not isinstance(event, dict):
        event = {}

    if event.get('agent_type') in (
        'worker',
        'devstandard:worker',
        'reviewer',
        'devstandard:reviewer',
    ):
        print('{}')
        return

    if subagent_role(event) is not None or event.get('parentConversationId'):
        print('{}')
        return

    pre_invocation = ('--pre-invocation' in sys.argv[1:]
                      or 'invocationNum' in event or 'initialNumSteps' in event)
    if pre_invocation and not needs_context(event):
        print('{}')
        return

    orchestrator_path = PLUGIN_ROOT / 'reference/orchestrator.md'
    try:
        page = orchestrator_path.read_text(encoding='utf-8')
    except (OSError, UnicodeDecodeError):
        warning = f"Stop before acting: DevStandard cannot read {orchestrator_path}. Report the missing role context to the caller."
        output = {
            "injectSteps": [
                {
                    "systemMessage": {
                        "systemMessage": warning
                    }
                }
            ]
        }
        print(json.dumps(output))
        return

    head = (
        f"DevStandard operating context: reference/orchestrator.md\n"
        f"Plugin root: {PLUGIN_ROOT}\n"
        "Complete artifact below: follow it before acting or replying. Resolve references from this root; load them only at their triggers.\n\n"
    )
    output = {
        "injectSteps": [
            {
                "systemMessage": {
                    "systemMessage": head + page
                }
            }
        ]
    }
    print(json.dumps(output))


if __name__ == '__main__':
    main()
