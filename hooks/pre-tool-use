#!/usr/bin/env python3
"""Refuse a tool call whose command text carries one of this role's words.

No parsing, no network, and nothing to configure: the word lists are in `hard_edges.py`
and this hook reads its event and the dispatcher-supplied role.
"""
import argparse
import json
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts'))
from hard_edges import tool_decision


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--role', choices=['orchestrator', 'worker', 'reviewer'], default='orchestrator')
    args = parser.parse_args()
    event = json.load(sys.stdin)
    role = args.role
    if role == 'orchestrator' and os.environ.get('DEVSTANDARD_ROLE') in ('worker', 'reviewer'):
        role = os.environ['DEVSTANDARD_ROLE']
    # A named child role overrides its parent process's inherited environment.
    # Explicit hook arguments still bind the role before either source.
    if args.role == 'orchestrator' and event.get('agent_type') in ('worker', 'devstandard:worker', 'reviewer', 'devstandard:reviewer'):
        role = event['agent_type'].split(':')[-1]
    # A child event carrying agent_id but no agent type (absent or `default`) takes the worker
    # list. It was added for native Codex children (ADR 0056), gone with the Codex host (ADR
    # 0063); it stays because an untyped child event would otherwise take the orchestrator's
    # narrower list. Named Claude research children keep their parent role.
    if (role == 'orchestrator' and event.get('agent_type') in (None, 'default')
            and isinstance(event.get('agent_id'), str) and event['agent_id'].strip()):
        role = 'worker'

    if 'toolCall' in event:
        tc = event['toolCall']
        if not isinstance(tc, dict):
            raise ValueError('toolCall must be an object')
        tool = tc.get('name')
        arguments = tc.get('args') or {}
        if not isinstance(tool, str) or not tool:
            raise ValueError('tool name must be a nonempty string')
        if tool == 'run_command':
            if not isinstance(arguments, dict):
                raise ValueError('run_command args must be an object')
            cmd = arguments.get('CommandLine')
            if not isinstance(cmd, str):
                raise ValueError('CommandLine must be a string')
        reason = tool_decision(role, tool, arguments)
        if reason:
            print(json.dumps({'decision': 'deny', 'reason': reason}))
        else:
            print(json.dumps({'decision': 'allow'}))
    else:
        tool, arguments = event['tool_name'], event['tool_input']
        if not isinstance(tool, str) or not tool:
            raise ValueError('tool_name must be a nonempty string')
        if tool in ('Bash', 'exec_command'):
            if not isinstance(arguments, dict):
                raise ValueError('shell tool_input must be an object')
            command = arguments.get('command', arguments.get('cmd'))
            if not isinstance(command, str):
                raise ValueError('shell command must be a string')
        reason = tool_decision(role, tool, arguments)
        if reason:
            print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse',
                'permissionDecision': 'deny', 'permissionDecisionReason': reason}}))
        else:
            print('{}')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        # Fail open (#437). A malformed host event or a bug below this line is the guard's
        # own defect, and denying on it stops every tool call in every lane at once — the
        # shape #338 hit. The call is admitted and one line names the error instead, which
        # a reader can act on. The three word rules above still refuse on their own path;
        # nothing here reads a file or the network, so there is no failure to retry.
        print('devstandard role hook admitted this call without deciding: '
              + ' '.join(repr(error).split()), file=sys.stderr)
        print('{}')
