#!/usr/bin/env python3
"""Statelessly assemble, dispatch, publish, and account for one PR's code reviews."""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
import review_packet as packet_format
from hard_edges import protection_read_refusal, protection_unavailable

loader = importlib.machinery.SourceFileLoader('dispatcher', str(Path(__file__).with_name('dispatch')))
spec = importlib.util.spec_from_loader(loader.name, loader)
dispatch = importlib.util.module_from_spec(spec)
loader.exec_module(dispatch)
require, run, git = dispatch.require, dispatch.run, dispatch.git
resolved, same_path = dispatch.resolved, dispatch.same_path

MARKER = '<!-- devstandard-review-v1 -->'
CONVERGENCE_CAP = 2
CONVERGENCE_WARNING = (
    '{rounds} review rounds consumed (2+ review rounds without convergence; '
    'escalate to the human if findings are repeating).'
)


def gh(project, *args):
    return json.loads(run('gh', *args, cwd=project))


def comments(project, repo, pr):
    raw = run('gh', 'api', f'repos/{repo}/issues/{pr}/comments', '--paginate', cwd=project)
    decoder, rows = json.JSONDecoder(), []
    while raw.strip():
        page, end = decoder.raw_decode(raw.lstrip())
        rows.extend(page)
        raw = raw.lstrip()[end:]
    return rows


def outcome(verdict, record):
    parsed = packet_format.parse_verdict(
        verdict, record.get('head') or '', record.get('identity'), allow_legacy=True
    )
    valid = parsed['valid']
    reason = parsed['reason']
    invocation = record.get('run') or {}
    if str(record.get('executor_exit', '0')) != '0' or invocation.get('harness_error'):
        valid = False
        reason = f"executor exit {record.get('executor_exit', '0')}"
        if invocation.get('harness_error'):
            reason += f"; harness error: {invocation['harness_error']}"
    result = dict(valid=valid, verdict=parsed['verdict'])
    if parsed.get('legacy'):
        result.update(legacy=True, legacy_floor_ok=parsed['legacy_floor_ok'])
    if reason:
        result['reason'] = reason
    return result


def records(rows):
    found = []
    for row in rows:
        body = row['body']
        match = re.match(
            r'## (?:Code Review|Review attempt|Merge check 1|Review ruling) — [^\n]+\n\n'
            + re.escape(MARKER) + r'\n```json\n(.*?)\n```\n',
            body,
            re.S,
        )
        if match:
            data = json.loads(match[1])
            data['comment_id'] = row['id']
            if data.get('status') == 'returned':
                data['verdict'] = body[match.end():].removeprefix('\n')
                data['outcome'] = outcome(data['verdict'], data)
            found.append(data)
            continuation = data.get('continuation')
            if (data.get('status') != 'returned' and isinstance(continuation, dict)
                    and continuation.get('kind') == 'ruling'):
                found.append(dict(continuation, comment_id=row['id']))
        elif re.match(r'^## (?:Code Review|[Mm]erge check 1)\b', body):
            number, verdict, warning = packet_format.comment_review(
                body, max((r['round'] for r in found if r.get('status') == 'returned'), default=0) + 1
            )
            identity = re.match(r'Reviewer: ([^\n]+?) — reviewed\s+([0-9a-fA-F]{40,64})', verdict)
            data = dict(
                kind='attempt', status='returned', round=number,
                head=identity[2] if identity else None,
                identity=identity[1] if identity else None,
                verdict=verdict, comment_id=row['id'],
            )
            if warning:
                data['warning'] = warning
            data['outcome'] = outcome(verdict, data)
            found.append(data)
    return found


def write_comment(project, repo, pr, record, verdict=None):
    if record['kind'] == 'ruling':
        title = f"Review ruling — round {record['round']}"
    else:
        title = f"Code Review — round {record['round']}"
    body = f'## {title}\n\n{MARKER}\n```json\n' + json.dumps(record, indent=2) + '\n```\n'
    if verdict is not None:
        body += '\n' + verdict
    require(len(body) <= 65536, 'whole verdict exceeds GitHub comment limit; retain the output and escalate; never truncate')
    endpoint = f'repos/{repo}/issues/{pr}/comments'
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json') as payload:
        json.dump({'body': body}, payload)
        payload.flush()
        return gh(project, 'api', endpoint, '--method', 'POST', '--input', payload.name)


def pr_view(project, repo, pr):
    return gh(project, 'pr', 'view', str(pr), '--repo', repo, '--json',
              'number,url,state,body,headRefName,headRefOid,baseRefName,baseRefOid')


def green(project, repo, pr):
    result = subprocess.run(['gh', 'pr', 'checks', str(pr['number']), '--repo', repo,
                             '--json', 'name,bucket,state'], cwd=project, text=True, capture_output=True)
    require(result.returncode in (0, 1, 8) and result.stdout.strip(),
            'PR checks unreported or unreadable: ' + result.stderr.strip())
    checks = json.loads(result.stdout)
    require(checks and all(c['bucket'] == 'pass' for c in checks), 'PR checks red, pending, skipped, or unreported')
    result = subprocess.run(['gh', 'api', f"repos/{repo}/branches/{pr['baseRefName']}/protection/required_status_checks"],
                             cwd=project, text=True, capture_output=True)
    if result.returncode:
        failure = result.stderr.strip() or result.stdout.strip()
        require('HTTP 404' in failure or protection_unavailable(failure),
                protection_read_refusal('required status checks read', failure))
    else:
        required = json.loads(result.stdout)
        names = set(required.get('contexts', [])) | {c['context'] for c in required.get('checks', [])}
        require(names <= {c['name'] for c in checks}, 'required PR checks unreported')
    latest = pr_view(project, repo, pr['number'])
    require(all(latest[k] == pr[k] for k in ('headRefOid', 'baseRefOid', 'body', 'state')),
            'PR changed during check admission; assemble again')
    return checks


def state(history, head):
    attempts = [r for r in history if r.get('kind') == 'attempt']
    returned = [r for r in attempts if r.get('status') == 'returned']
    warnings = [r['warning'] for r in returned if r.get('warning')]
    numbers = [r['round'] for r in returned]
    if numbers != list(range(1, len(returned) + 1)):
        warnings.append(f'review history has missing, duplicate or out-of-order rounds: {numbers}; reconcile it')
    last = returned[-1] if returned else None
    after_verdict = history[history.index(last) + 1:] if last else []
    rulings = [r for r in after_verdict if r.get('kind') == 'ruling' and r['round'] == last['round']
               and r['head'] == last['head']]
    ruling = packet_format.latest_ruling(rulings)
    verdict_val = last['outcome'].get('verdict') if last else None
    next_step = 'review'
    accepted = False
    if last:
        out = last['outcome']
        merge_as_is_ok = bool(
            ruling and ruling.get('decision') == 'merge-as-is'
            and (ruling.get('human_authorization') or '').strip()
            and out.get('legacy_floor_ok', True)
        )
        if last['head'] != head:
            next_step = 'full-review'
        elif ruling and ruling['decision'] != 'merge-as-is':
            next_step = 'full-review' if ruling['decision'] == 'continue' else ruling['decision']
        elif out.get('valid') and (verdict_val == 'Approve' or merge_as_is_ok):
            next_step = 'accepted'
            accepted = True
        elif not out.get('valid'):
            next_step = 'invalid-verdict'
        else:
            next_step = 'fix-or-escalate'
    status = dict(
        rounds=len(returned),
        next_round=max(numbers, default=0) + 1,
        next=next_step,
        accepted=accepted,
        verdict=verdict_val,
        head=last['head'] if last else None,
        last=last,
        ruling=ruling,
        warnings=warnings,
    )
    if len(returned) >= CONVERGENCE_CAP and not accepted:
        status['warning'] = CONVERGENCE_WARNING.format(rounds=len(returned))
    return status


def warn(status):
    if status.get('warning'):
        print('review-packet warning: ' + status['warning'], file=sys.stderr)
    for warning in status.get('warnings', []):
        print('review-packet warning: ' + warning, file=sys.stderr)


def admit_round(status, current_head):
    if status['accepted'] and status['last'] and status['last']['head'] == current_head:
        require(packet_format.recovery_ruling(status['ruling'], current_head),
                'accepted verdict: Notes do not authorize another round')


def ci_fallback(project, repo, url):
    if not url:
        return 'NONE'
    match = re.fullmatch(re.escape(f'https://github.com/{repo}/') + r'(?:issues|pull)/\d+#issuecomment-(\d+)', url)
    require(match, 'CI fallback must be a published issue or PR comment URL of this repository')
    body = gh(project, 'api', f'repos/{repo}/issues/comments/{match[1]}')['body']
    require(body and body.strip(), 'CI fallback comment is empty')
    return f'Published at {url}\n\n{body}'


def assemble(args, project, repo, pr, issue, history):
    require(pr['state'] == 'OPEN', 'assembly requires an open PR')
    fields = packet_format.issue_contract(issue['body'])
    lanes = [r for r in dispatch.records(issue['comments']) if r.get('kind') == 'lane']
    require(lanes, 'no issue-side lane record; adopt or dispatch the lane first')
    lane = lanes[-1]
    gaps = []
    if lane['repo'] != repo or lane['branch'] != pr['headRefName']:
        gaps.append(f'PR differs from recorded issue lane: recorded {lane["repo"]} '
                    f'{lane["branch"]}; PR {repo} {pr["headRefName"]}')
    dispatch.lane_check(project, lane)
    checks = green(project, repo, pr)
    git(project, 'fetch', 'origin', pr['baseRefName'], f"refs/pull/{pr['number']}/head")

    def reported(name, read, absent):
        try:
            return read()
        except (dispatch.Refusal, ValueError, OSError) as error:
            gaps.append(f'{name}: {error}')
            return absent

    for name, sha in (('REVIEW_BASE_SHA', pr['baseRefOid']), ('HEAD_SHA', pr['headRefOid'])):
        if packet_format.SHA.fullmatch(sha):
            reported(f'{name}: {sha} is not a readable commit here',
                     lambda sha=sha: git(project, 'cat-file', '-e', sha + '^{commit}'), None)
    configured = reported('CI_CONFIGURATION_PATHS',
                          lambda: packet_format.ci_configuration_paths(
                              project, pr['baseRefOid'], pr['headRefOid']), None)
    implementation = args.implementation or 'codex'
    model, effort = dispatch.route_setting('reviewer', implementation, args.model, args.effort)
    identity = (f'Codex, {model} at {effort}' if implementation == 'codex'
                else f'Antigravity subagent, {model}')
    slots = dict(
        REVIEWER_IDENTITY=identity,
        ISSUE_GOAL_STATEMENT=fields['goal'],
        ISSUE_BOUNDS=fields['bounds'],
        ISSUE_DONE_CHECK=fields['done-check'],
        COMPLETE_PR_DESCRIPTION=pr['body'],
        REVIEW_BASE_SHA=pr['baseRefOid'],
        HEAD_SHA=pr['headRefOid'],
        CI_CONFIGURATION_PATHS='UNKNOWN' if configured is None else ' '.join(configured) or 'NONE',
        CI_FALLBACK_COMMENT_OR_NONE=ci_fallback(project, repo, args.ci_fallback),
    )
    packet = dict(format=packet_format.FORMAT, template=packet_format.template(), slots=slots,
                  issue_body=issue['body'], issue_state=issue['state'], integrity_gaps=gaps)
    packet['slots'] = packet_format.validate(packet)
    packet['prior_verdicts'] = [r['verdict'] for r in history if r.get('status') == 'returned']
    if args.rebase_result:
        packet['rebase_result'] = json.loads(args.rebase_result.read_text())
    brief = packet_format.render(packet)
    green(project, repo, pr)
    require(args.output is not None, '--output scratch directory is required')
    output = resolved(args.output, 'output')
    output.mkdir(parents=True, exist_ok=True)
    path = output / 'packet.json'
    path.write_text(json.dumps(packet, indent=2) + '\n')
    (output / 'packet.txt').write_text(brief)
    assembled = dict(
        packet=str(path), brief=str(output / 'packet.txt'),
        head=pr['headRefOid'], base=pr['baseRefOid'],
        identity=identity, implementation=implementation,
        model=model, effort=effort, checks=checks,
    )
    if args.architecture_level:
        assembled['architecture'] = args.architecture_level.upper()
    return assembled


def publish_verdict(project, repo, pr_num, verdict, meta):
    require(verdict and verdict.strip(), 'reviewer returned no verdict')
    parsed = packet_format.parse_verdict(verdict, meta['head'], meta['identity'], allow_legacy=False)
    require(parsed['valid'], f"invalid reviewer verdict: {parsed['reason']}")
    history = records(comments(project, repo, pr_num))
    status = state(history, meta['head'])
    admit_round(status, meta['head'])
    warn(status)
    round_num = status['next_round']
    outcome_obj = dict(valid=True, verdict=parsed['verdict'])
    record = dict(
        kind='attempt',
        status='returned',
        round=round_num,
        head=meta['head'],
        base=meta['base'],
        identity=meta['identity'],
        implementation=meta['implementation'],
        model=meta['model'],
        effort=meta['effort'],
        outcome=outcome_obj,
        verdict_sha256=hashlib.sha256(verdict.encode()).hexdigest(),
    )
    if 'run' in meta:
        record['run'] = meta['run']
    if 'executor_exit' in meta:
        record['executor_exit'] = str(meta['executor_exit'])
    if meta.get('architecture'):
        record['architecture'] = meta['architecture']
    if meta.get('reason'):
        record['reason'] = meta['reason']
    response = write_comment(project, repo, pr_num, record, verdict)
    return dict(comment_id=response['id'], round=round_num, head=meta['head'], base=meta['base'],
                identity=meta['identity'], status='returned', outcome=outcome_obj)


def publish(args, project, repo):
    require(args.verdict is not None, '--verdict <file> is required')
    verdict = args.verdict.read_text()
    attempt_file = (resolved(args.output, 'output') / 'attempt.json') if args.output is not None else None
    if attempt_file and attempt_file.is_file():
        meta = json.loads(attempt_file.read_text())
    else:
        pr = pr_view(project, repo, args.pr)
        implementation = args.implementation or 'agy'
        model, effort = dispatch.route_setting('reviewer', implementation, args.model, args.effort)
        identity = (f'Codex, {model} at {effort}' if implementation == 'codex'
                    else f'Antigravity subagent, {model}')
        meta = dict(head=pr['headRefOid'], base=pr['baseRefOid'], identity=identity,
                    implementation=implementation, model=model, effort=effort)
        if args.architecture_level:
            meta['architecture'] = args.architecture_level.upper()
        if args.reason:
            meta['reason'] = args.reason
    return publish_verdict(project, repo, args.pr, verdict, meta)


def rule(args, project, repo, pr, status):
    last = status['last']
    require(last, 'no returned verdict to rule on')
    require(args.reason and args.reason.strip(), '--reason is required for an orchestrator ruling')
    require(args.decision, '--decision is required')
    recovery = None
    if args.decision == 'merge-as-is':
        require(args.human_authorization and args.human_authorization.strip(),
                'merge-as-is requires --human-authorization')
        require(last['head'] == pr['headRefOid'], 'ruling cannot accept a different head')
        require(last['outcome'].get('valid') and last['outcome'].get('legacy_floor_ok', True),
                'merge-as-is requires a valid returned verdict')
        green(project, repo, pr)
    if args.decision == 'continue' and status['accepted']:
        head = pr['headRefOid']
        if args.guard_refusal is not None:
            require(args.guard_refusal.strip(), 'guard refusal must contain the observed refusal')
            recovery = dict(kind='guard-refusal', head=head, reason=args.guard_refusal)
        else:
            default = gh(project, 'api', f'repos/{repo}')['default_branch']
            require(pr['baseRefName'] == default, 'accepted-head recovery requires the default branch')
            git(project, 'fetch', 'origin', default, f"refs/pull/{pr['number']}/head")
            base = pr['baseRefOid']
            require(packet_format.SHA.fullmatch(base) and packet_format.SHA.fullmatch(head),
                    'recovery requires full base/head SHAs')
            behind = int(git(project, 'rev-list', '--count', head + '..' + base))
            require(behind > 0, 'Notes do not trigger a re-review; accepted head is current and has no guard refusal')
            recovery = dict(kind='behind-base', head=head, base=base)
        latest = pr_view(project, repo, args.pr)
        require(all(latest[k] == pr[k] for k in ('state', 'headRefOid', 'baseRefName', 'baseRefOid')),
                'PR changed during recovery admission; rule again')
    human = args.decision in ('merge-as-is', 'abandon', 'change-route') or args.human_touchpoint
    require(not human or (args.human_authorization and args.human_authorization.strip()),
            'directional or human-touchpoint ruling requires --human-authorization')
    record = dict(kind='ruling', round=last['round'], head=last['head'], decision=args.decision,
                  reason=args.reason.strip(), human_authorization=args.human_authorization)
    if recovery:
        record['recovery'] = recovery
    write_comment(project, repo, args.pr, record)
    return record


def start(args, project, repo, pr, issue, history):
    status = state(history, pr['headRefOid'])
    admit_round(status, pr['headRefOid'])
    warn(status)
    assembled = assemble(args, project, repo, pr, issue, history)
    command = [sys.executable, str(Path(__file__).with_name('dispatch')), str(args.issue),
               '--project', str(project), '--purpose', 'reviewer', '--pr', str(args.pr),
               '--packet', assembled['packet'], '--implementation', assembled['implementation'],
               '--model', assembled['model']]
    if assembled['effort'] is not None:
        command += ['--effort', assembled['effort']]
    if assembled['implementation'] == 'codex':
        command.append('--wait')
    result = subprocess.run(command, cwd=project, text=True, capture_output=True)
    require(result.stdout.strip(), result.stderr.strip() or f'dispatch exit {result.returncode}')
    invocation = json.loads(result.stdout)
    if assembled['implementation'] == 'codex':
        executor_exit = invocation.get('executor_exit', result.returncode)
        harness_error = invocation.get('harness_error')
        require(executor_exit == 0 and not harness_error,
                f'reviewer CLI failed (exit {executor_exit})'
                + (f': {harness_error}' if harness_error else ''))
        source = Path(invocation['output'])
        require(source.is_file() and source.read_text().strip(),
                f'reviewer exited {executor_exit} with no verdict')
        verdict = source.read_text()
        meta = dict(assembled, run=invocation, executor_exit=executor_exit, reason=args.reason)
        publication = publish_verdict(project, repo, args.pr, verdict, meta)
        return dict(round=publication['round'], comment_id=publication['comment_id'],
                    status='returned', **assembled, run=invocation,
                    outcome=publication['outcome'], publication=publication)

    attempt = dict(
        round=status['next_round'],
        head=assembled['head'],
        base=assembled['base'],
        identity=assembled['identity'],
        implementation=assembled['implementation'],
        model=assembled['model'],
        effort=assembled['effort'],
        packet=assembled['packet'],
        brief=assembled['brief'],
        run=invocation,
    )
    if args.architecture_level:
        attempt['architecture'] = args.architecture_level.upper()
    if args.reason:
        attempt['reason'] = args.reason
    attempt_path = Path(assembled['packet']).parent / 'attempt.json'
    attempt_path.write_text(json.dumps(attempt, indent=2) + '\n')
    attempt['attempt_file'] = str(attempt_path)
    return attempt


REVIEW_EPILOG = """STATELESS ASSEMBLY AND PUBLICATION CONTRACT (the caller-facing detail
reference/orchestrator.md points here for; that page keeps the decision and the command line).

  Assembly. Pins the review base and head, verifies all observed PR checks and required contexts
  pass, reads prior published review comments, and writes packet.json + packet.txt in --output.
  --ci-fallback COMMENT_URL embeds a published CI-FALLBACK comment into the reviewer's slot.

  Stateless start and publish. No pre-flight reservation comments are posted on the PR.
  For Codex (--implementation codex --wait), start waits for CLI exit, validates verdict_shape(),
  and posts one whole `## Code Review — round N` PR comment upon a valid return (or exits nonzero
  on stderr without posting broken comments if the CLI fails or returns invalid output).
  For native Antigravity (--implementation agy), start writes <output>/attempt.json alongside
  packet.json (`run.status == "awaiting-agent-tool"`); once the subagent returns its verdict via
  send_message, publish --verdict <file> [--output <dir>] validates verdict_shape() and posts one
  whole `## Code Review — round N` PR comment.

  Convergence and rulings. `status` reports published rounds, latest verdict (`Approve` or
  `Request changes`), and `accepted`, warning when 2+ rounds pass without convergence so the
  orchestrator escalates repeated findings to the human. `rule --decision merge-as-is` requires
  both --reason and --human-authorization on the current green head.
"""


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=REVIEW_EPILOG,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('action', choices=['assemble', 'start', 'publish', 'status', 'rule'])
    parser.add_argument('pr', type=int)
    parser.add_argument('--issue', type=int)
    parser.add_argument('--project', type=Path, default=Path.cwd())
    parser.add_argument('--output', type=Path, help='caller-owned session scratch directory')
    parser.add_argument('--architecture-level', choices=['yes', 'no'], required=False,
                        help='optional compatibility flag recorded in metadata when supplied')
    parser.add_argument('--ci-fallback', help='start/assemble: URL of the published CI-FALLBACK comment; otherwise NONE')
    parser.add_argument('--rebase-result', type=Path, help='guard compare JSON result as evidence; never an acceptance bypass')
    parser.add_argument('--implementation', choices=['codex', 'agy'])
    parser.add_argument('--model', help='start/assemble/publish: explicit reviewer model override')
    parser.add_argument('--effort', help='start/assemble/publish: explicit reviewer effort override')
    parser.add_argument('--wait', action='store_true', help='CLI start only: wait through synchronous publication')
    parser.add_argument('--verdict', type=Path, help='publish: file containing the whole Antigravity subagent verdict')
    parser.add_argument('--decision', choices=['continue', 'merge-as-is', 'rewrite', 'abandon', 'change-route'])
    parser.add_argument('--reason', help='optional fix note on start; required reason on rule')
    parser.add_argument('--guard-refusal', help='rule --decision continue: guard refusal observed on an accepted head')
    parser.add_argument('--human-touchpoint', action='store_true')
    parser.add_argument('--human-authorization', help='required human authorization for merge-as-is or directional rulings')
    args = parser.parse_args()
    resolved_impl = args.implementation or ('agy' if args.action == 'publish' else 'codex')
    require(not (args.model is not None or args.effort is not None) or args.action in ('start', 'assemble', 'publish'),
            '--model and --effort require start, assemble, or publish')
    require(args.ci_fallback is None or args.action in ('start', 'assemble'),
            '--ci-fallback requires start or assemble')
    require(not args.wait or (args.action == 'start' and resolved_impl == 'codex'),
            f'--wait requires start with a CLI executor; resolved implementation: {resolved_impl}')
    require(args.action != 'start' or resolved_impl != 'codex' or args.wait,
            'CLI start requires --wait; run it as a harness background task')
    require(args.guard_refusal is None or (args.action == 'rule' and args.decision == 'continue'
                                           and args.guard_refusal.strip()),
            '--guard-refusal requires rule --decision continue and a nonempty observed refusal')
    require(args.pr > 0 and (args.issue is None or args.issue > 0), 'PR and issue must be positive')
    project = resolved(args.project, 'project')
    require(same_path(git(project, 'rev-parse', '--show-toplevel'), project), '--project must be a checkout root')
    repo = run('gh', 'repo', 'view', '--json', 'nameWithOwner', '--jq', '.nameWithOwner', cwd=project)
    if args.action == 'publish':
        result = publish(args, project, repo)
    else:
        history = records(comments(project, repo, args.pr))
        pr = pr_view(project, repo, args.pr)
        status = state(history, pr['headRefOid'])
        if args.action == 'status':
            result = status
            warn(status)
        elif args.action == 'rule':
            result = rule(args, project, repo, pr, status)
        else:
            args.implementation = resolved_impl
            require(pr['state'] == 'OPEN', 'assembly requires an open PR')
            require(args.issue is not None, '--issue is required for review assembly/start')
            issue = gh(project, 'issue', 'view', str(args.issue), '--repo', repo,
                       '--json', 'number,title,url,body,state,comments')
            result = (start if args.action == 'start' else assemble)(args, project, repo, pr, issue, history)
    print(json.dumps(result, indent=2))


if __name__ == '__main__':
    try:
        main()
    except (dispatch.Refusal, OSError, ValueError, KeyError) as error:
        print(f'review-packet refused: {error}', file=sys.stderr)
        sys.exit(2)
